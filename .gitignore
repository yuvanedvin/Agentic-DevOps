
# Terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Environment variables and secrets
.env
.env.*
!.env.example

# AWS credentials
.aws/
credentials
config

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Kubernetes secrets
secrets.yaml
secret.yaml
**/secrets/

# Application build artifacts
target/
build/
dist/
node_modules/
__pycache__/
*.pyc

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
